{
  "name": "parapex",
  "version": "0.2.0",
  "description": "Parapex - a deckbuilding roguelike siege. Five towers, five rounds, one enemy.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "blick": "node scripts/blick.mjs",
    "blick:grundlage": "node scripts/blick.mjs --grundlage",
    "blick:vergleich": "python3 scripts/art/vergleich.py",
    "last": "node scripts/last.mjs",
    "golden": "node scripts/golden.mjs",
    "legacy:build": "node scripts/baue.mjs",
    "legacy:typecheck": "tsc -p tsconfig.legacy.json",
    "legacy:test": "node scripts/baue.mjs && tsc -p tsconfig.legacy.json && node scripts/pruefe-kern.mjs && node scripts/pruefe-feldzug.mjs && node scripts/pruefe.mjs",
    "legacy:serve": "node scripts/serve.js",
    "legacy:bot": "node scripts/bot.mjs",
    "legacy:style": "node scripts/stil.mjs",
    "golden:draws": "node scripts/goldenDraws.mjs",
    "golden:combat": "node scripts/goldenCombat.mjs",
    "golden:crests": "node scripts/goldenCrests.mjs",
    "golden:shapes": "node scripts/goldenCrestShapes.mjs",
    "art": "python3 scripts/art/pipeline.py",
    "art:check": "python3 scripts/art/pipeline.py --selftest"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "pixi.js": "^8.20.1"
  }
}
