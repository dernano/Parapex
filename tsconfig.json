{
  "//": "Keine TypeScript-Dateien - nur JavaScript mit JSDoc, gepruueft ohne Uebersetzung. Es entsteht KEIN Ausgabecode; `tsc` liest nur mit.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["quelle/**/*.js"]
}
